# Copy to .env (gitignored) and fill in. Never commit real values.

# SEC EDGAR fair-access policy requires a descriptive User-Agent including
# contact information, e.g. "Detector_Fin research (you@example.com)".
SEC_EDGAR_USER_AGENT=

# OpenDART API key for KR disclosures (free registration at
# https://opendart.fss.or.kr/). The dart adapter yields empty batches
# without it.
DART_API_KEY=
